{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor for Jungle Gaming technical challenge",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "start:prod": "bun run dist/main.js",
    "test": "bun test test",
    "test:integration": "bun test test/integration",
    "test:watch": "bun test --watch test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:run": "bun run src/database/migrate.ts up",
    "migration:revert": "bun run src/database/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.840.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/bun": "^1.2.15",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "bun": "^1.4.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}